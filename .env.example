# Copy to .env and fill in values. Never commit .env.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Trino MCP server (alaturqua/mcp-trino-python — Python, run via uvx)
TRINO_MCP_COMMAND=uvx
TRINO_MCP_ARGS=mcp-trino-python

# Trino connection (passed as env vars to the MCP server process)
TRINO_HOST=localhost
TRINO_PORT=8081
TRINO_USER=admin
TRINO_CATALOG=hive

# OpenMetadata (1.12.x ships a built-in MCP server inside the app — no separate process to spawn)
OPENMETADATA_URL=http://localhost:8585
OPENMETADATA_TOKEN=your-jwt-token-here

# Model backends
ANTHROPIC_MODEL=claude-sonnet-4-6
# Per machine: qwen2.5:14b on GPU laptop, qwen2.5:7b on work laptop (CPU-only)
LOREKEEPER_OLLAMA_MODEL=qwen2.5:14b
