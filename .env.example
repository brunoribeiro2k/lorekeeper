# Copy to .env and fill in values. Never commit .env.

# Trino connection (used by alaturqua/mcp-trino-python in Phase 2)
TRINO_HOST=localhost
TRINO_PORT=8081
TRINO_USER=admin
TRINO_CATALOG=hive

# OpenMetadata — built-in MCP server at $OPENMETADATA_URL/mcp (no separate process)
# Token: generate in OM UI → Settings → Users → Admin → Access Token
OPENMETADATA_URL=http://localhost:8585
OPENMETADATA_TOKEN=your-jwt-token-here

# Model backends
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
# Per machine: qwen2.5:14b on primary laptop (GPU), qwen2.5:7b on secondary laptop (RAM, CPU-only)
LOREKEEPER_OLLAMA_MODEL=qwen2.5:14b
