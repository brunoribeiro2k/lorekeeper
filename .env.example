# Copy to .env and fill in values. Never commit .env.

# Trino — direct client connection (for testing outside MCP)
# MCP server is managed by local-env/trino-local, registered user-scoped in Claude Code
TRINO_HOST=localhost
TRINO_PORT=8081
TRINO_USER=admin
TRINO_CATALOG=hive

# OpenMetadata — MCP server registered user-scoped in Claude Code
# Token only needed here if the agent calls OM APIs directly (outside MCP)
OPENMETADATA_URL=http://localhost:8585
OPENMETADATA_TOKEN=your-jwt-token-here

# Model backends
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
# Per machine: qwen2.5:14b on primary laptop (GPU), qwen2.5:7b on secondary laptop (RAM, CPU-only)
LOREKEEPER_OLLAMA_MODEL=qwen2.5:14b
