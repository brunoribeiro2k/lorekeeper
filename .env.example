# Copy to .env and fill in values. Never commit .env.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Trino MCP server command (the binary or script that starts the MCP server)
# Option A: Go binary  → TRINO_MCP_COMMAND=mcp-trino
# Option B: Python uvx → TRINO_MCP_COMMAND=uvx  +  TRINO_MCP_ARGS=mcp-trino-python
TRINO_MCP_COMMAND=mcp-trino

# Trino connection (passed as env vars to the MCP server process)
TRINO_HOST=localhost
TRINO_PORT=8081
TRINO_USER=admin
TRINO_CATALOG=hive

# OpenMetadata MCP server (Phase 2 — not needed for Phase 1)
# uvx mcp-server-openmetadata reads OPENMETADATA_URL and OPENMETADATA_TOKEN
OPENMETADATA_MCP_COMMAND=uvx
OPENMETADATA_MCP_ARGS=mcp-server-openmetadata
OPENMETADATA_URL=http://localhost:8585
OPENMETADATA_TOKEN=your-jwt-token-here

# Model backends
ANTHROPIC_MODEL=claude-sonnet-4-6
OLLAMA_MODEL=qwen2.5:14b
